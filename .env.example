# ── 리포트 작성 방식 ─────────────────────────────────────────
# 비워 두면 Claude Code 작성 모드: 웹은 작성 의뢰서만 저장하고, Claude Code 의 /write-report 가 글을 씁니다.
# Anthropic API 를 호출하지 않으므로 API 토큰 비용이 들지 않습니다.
# LETTER_WRITER=api 로 바꾸고 키를 넣으면 웹에서 API 로 바로 작성합니다(사용량만큼 과금).
# LETTER_WRITER=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ── 구글 시트 연결 (무료, 구글 클라우드 불필요) ─────────────────
# 시트의 확장 프로그램 > Apps Script 에 apps-script/Code.gs 를 붙이고 웹 앱으로 배포한 뒤 주소와 토큰을 넣습니다.
# 설명서: docs/DEPLOY.md 1번
SHEETS_WEBAPP_URL=
SHEETS_WEBAPP_TOKEN=

# (선택) 구글 클라우드 서비스 계정 방식. 위 두 값이 있으면 그쪽이 우선합니다.
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON=      # 키 JSON 내용 / 또는 _KEY_PATH=./credentials.json / _KEY_BASE64=

# ── 웹 운영 ────────────────────────────────────────────────
# 웹 서버(Vercel 등)에서는 자동으로 sheets. 내 PC에서도 시트를 원본으로 쓰려면 sheets
# STORE_MODE=sheets
# APP_PASSWORD=                     # 웹 접속 비밀번호
# 설명서: docs/DEPLOY.md

# ── 옵션 ───────────────────────────────────────────────────
# COLLECT_LOOKBACK_DAYS=14          # 기사 최신화 수집 기간(일)
# MI_LOOKBACK_DAYS=180              # 과거 발행 이력 비교 기간(일, 3~6개월 권장)

# ── 리포트 표기 ────────────────────────────────────────────
# NEWSLETTER_NAME=TDL Trend                    # 헤더: 테크이노베이션팀 | TDL Trend 제N호
# NEWSLETTER_FEEDBACK_CONTACT=테크이노베이션팀     # 발행 팀
# NEWSLETTER_AUDIENCE=CL사업부                   # 배포 대상, 'CL사업부 시사점'
# NEWSLETTER_FEEDBACK_EMAIL=                    # 푸터 문의 메일 (선택)
# DATA_DIR=./data                   # 로컬 캐시 위치
