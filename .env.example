# ── 레터 작성 방식 ─────────────────────────────────────────
# 비워 두면 Claude Code 작성 모드: 웹은 작성 의뢰서만 저장하고, Claude Code 의 /write-letter 가 글을 씁니다.
# Anthropic API 를 호출하지 않으므로 API 토큰 비용이 들지 않습니다.
# LETTER_WRITER=api 로 바꾸고 키를 넣으면 웹에서 API 로 바로 작성합니다(사용량만큼 과금).
# LETTER_WRITER=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ── Google Sheets (원장 DB) ────────────────────────────────
# 스프레드시트 URL의 /d/<ID>/edit 부분. 서비스 계정 이메일에 '편집자' 권한으로 공유해야 합니다.
GOOGLE_SHEETS_SPREADSHEET_ID=
# 셋 중 하나: 키 파일 경로 / JSON 내용 그대로 / base64
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials.json
# GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# ── 웹 운영 ────────────────────────────────────────────────
# 웹 서버(Vercel 등)에서는 자동으로 sheets. 내 PC에서도 시트를 원본으로 쓰려면 sheets
# STORE_MODE=sheets
# APP_PASSWORD=                     # 웹 접속 비밀번호
# 설명서: docs/DEPLOY.md

# ── 옵션 ───────────────────────────────────────────────────
# COLLECT_LOOKBACK_DAYS=14          # 기사 최신화 수집 기간(일)
# MI_LOOKBACK_DAYS=180              # 과거 발행 이력 비교 기간(일, 3~6개월 권장)

# ── 리포트 표기 ────────────────────────────────────────────
# NEWSLETTER_NAME=TDL Trend                    # 헤더: 테크이노베이션팀 | TDL Trend 제N호
# NEWSLETTER_FEEDBACK_CONTACT=테크이노베이션팀     # 발행 팀
# NEWSLETTER_AUDIENCE=CL사업부                   # 배포 대상, 'CL사업부 시사점'
# NEWSLETTER_FEEDBACK_EMAIL=                    # 푸터 문의 메일 (선택)
# DATA_DIR=./data                   # 로컬 캐시 위치
