# ── Claude API (뉴스레터 작성 엔진) ─────────────────────────
# 비워두면 '기본 초안 모드'(기사 원문 기반 규칙 초안)로 동작합니다.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ── Google Sheets (원장 DB) ────────────────────────────────
# 스프레드시트 URL의 /d/<ID>/edit 부분. 서비스 계정 이메일에 '편집자' 권한으로 공유해야 합니다.
GOOGLE_SHEETS_SPREADSHEET_ID=
# 둘 중 하나: 키 파일 경로 또는 JSON 키를 base64 인코딩한 값
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials.json
# GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# ── 옵션 ───────────────────────────────────────────────────
# COLLECT_LOOKBACK_DAYS=14          # 기사 최신화 수집 기간(일)
# MI_LOOKBACK_DAYS=180              # 과거 발행 이력 비교 기간(일, 3~6개월 권장)
# ── 레포냥 레터 ─────────────────────────────────────────────
# NEWSLETTER_NAME=REPONYANG
# NEWSLETTER_TAGLINE=2주마다 물어 오는 물류·로봇 트렌드 레터
# NEWSLETTER_FEEDBACK_CONTACT=테크이노베이션팀   # 발행 팀
# NEWSLETTER_AUDIENCE=CL사업부                 # 독자 ('우리 CL사업부엔?' 박스)
# 답장/설문 버튼: 설문 폼 주소가 있으면 폼으로(?issue=N&answer=good|bad), 없으면 이 주소로 답장 메일
# NEWSLETTER_FEEDBACK_EMAIL=
# NEWSLETTER_SURVEY_URL=
# NEWSLETTER_ARCHIVE_URL=           # 헤더의 '지난 레터 보기' 링크
# 캐릭터 이미지 공개 기준 URL (예: https://mi.사내도메인). 비우면 복사 시 현재 접속 주소로 변환
# PUBLIC_ASSET_BASE_URL=
# DATA_DIR=./data                   # 로컬 캐시 위치
